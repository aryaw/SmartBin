# Training
EPOCHS=200
USE_DOCKER=false
YOLO_BATCH_SIZE=16
YOLO_MAX_IMAGES=0

# Dataset
DATASET_PATH=backend/dataset

# GPU
CUDA_VISIBLE_DEVICES=0
DEVICE=cuda:0
VRAM_LIMIT_GB=12

# Paths (relative to backend/)
UPLOAD_DIR=uploads
LOG_DIR=log
STATIC_DIR=static
RESULT_DIR=static/result
MODEL_DIR=models
MODEL_PATH=models/best.pt
ANNOTATIONS_FILE=../datasource/annotations.json

# Limits
MAX_FILE_SIZE=209715200

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartbin
DB_USER=postgres
DB_PASS=your_db_password
